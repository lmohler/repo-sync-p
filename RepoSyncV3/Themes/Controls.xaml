<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:RepoSyncV3.Models"
                    xmlns:v="clr-namespace:RepoSyncV3.Views"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- v3 additions on top of Styles.xaml (carried over from v2). -->

    <!-- keyboard focus ring for every control: accent colored, so it shows on the dark theme too (WPF's default is a black dotted line) -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{DynamicResource Brush.Accent}" RadiusX="4" RadiusY="4" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <FontFamily x:Key="Font.Mono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============================ Text ============================ -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    </Style>
    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Text.Big" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    </Style>

    <!-- ============================ Pills / badges ============================ -->
    <!-- A small rounded label. Set Tag to success / warning / error / info / purple for the color. -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="7,1,7,2"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Tint.Neutral}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="success">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Success}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Success}"/>
            </Trigger>
            <Trigger Property="Tag" Value="warning">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Warning}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Warning}"/>
            </Trigger>
            <Trigger Property="Tag" Value="error">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </Trigger>
            <Trigger Property="Tag" Value="info">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Info}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Info}"/>
            </Trigger>
            <Trigger Property="Tag" Value="purple">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Purple}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Purple}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Pipeline status pill: DataContext-free, bind Tag to a pipeline/job Kind string. -->
    <Style x:Key="Pill.Pipeline" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="failed">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </Trigger>
            <Trigger Property="Tag" Value="running">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Info}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Info}"/>
            </Trigger>
            <Trigger Property="Tag" Value="pending">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Warning}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Warning}"/>
            </Trigger>
            <Trigger Property="Tag" Value="manual">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Purple}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Purple}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Merge request pill: Tag = merged / closed / conflicts / draft / ready / open. -->
    <Style x:Key="Pill.MergeRequest" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="merged">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Purple}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Purple}"/>
            </Trigger>
            <Trigger Property="Tag" Value="conflicts">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </Trigger>
            <Trigger Property="Tag" Value="ready">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Success}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Success}"/>
            </Trigger>
            <Trigger Property="Tag" Value="open">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Info}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Info}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small status dot: Tag = a pipeline Kind. -->
    <Style x:Key="Dot.Pipeline" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource Brush.Status.Unknown}"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="success">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Clean}"/>
            </Trigger>
            <Trigger Property="Tag" Value="failed">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Conflict}"/>
            </Trigger>
            <Trigger Property="Tag" Value="running">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Ahead}"/>
            </Trigger>
            <Trigger Property="Tag" Value="pending">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Dirty}"/>
            </Trigger>
            <Trigger Property="Tag" Value="manual">
                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Behind}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- File status letter (M / A / D / R / U / !) in a colored square. Tag = FileChange.Code as text. -->
    <Style x:Key="FileBadge" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Tint.Warning}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Warning}"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="A">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Success}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Success}"/>
            </Trigger>
            <Trigger Property="Tag" Value="?">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Success}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Success}"/>
            </Trigger>
            <Trigger Property="Tag" Value="D">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </Trigger>
            <Trigger Property="Tag" Value="!">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.Conflict}"/>
                <Setter Property="TextElement.Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="Tag" Value="R">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Info}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Info}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Buttons ============================ -->
    <!-- Borderless icon/text button for rows and headers. -->
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ButtonSecondaryBackgroundHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip in the sidebar -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonSecondaryBorder}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="8,2">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ButtonSecondaryBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ TabControl ============================ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0,0,0,-1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,6,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,5" Background="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ListBox ============================ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <!-- spacing, overridden at app level by Services/Density (compact density setting) -->
    <Thickness x:Key="Density.ItemPadding">7,3</Thickness>
    <sys:Double x:Key="Density.RowHeight">24</sys:Double>
    <Thickness x:Key="Density.CardMargin">0,0,2,4</Thickness>
    <Thickness x:Key="Density.CardContent">9,6,8,6</Thickness>
    <sys:Double x:Key="Density.Avatar">30</sys:Double>
    <Thickness x:Key="Density.AvatarMargin">8,7,0,0</Thickness>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource Density.ItemPadding}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.DataGridRowHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.DataGridSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ DataGrid rows ============================ -->
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DataGridRowHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DataGridSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grid.List" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.PanelBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="{DynamicResource Density.RowHeight}"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <!-- ============================ PasswordBox ============================ -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.InputBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="7,3"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.InputBorderFocus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Misc ============================ -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="DialogWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="SizeToContent" Value="Height"/>
    </Style>

    <!-- ============================ Diff viewer ============================ -->
    <Style x:Key="DiffList" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Diff.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <!-- F7 / Shift+F7 (or Alt+Down / Alt+Up) jump between change blocks -->
        <Setter Property="v:DiffNav.IsEnabled" Value="True"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Diff.Text}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.DataGridSelected}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffKind.Add}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Diff.AddBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Diff.AddText}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffKind.Delete}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Diff.DeleteBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Diff.DeleteText}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffKind.Hunk}">
                            <Setter Property="Background" Value="{DynamicResource Brush.Diff.HunkBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Diff.HunkText}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:DiffKind.Meta}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Diff.Gutter}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="m:DiffLine">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OldNo}" Width="42" TextAlignment="Right" Foreground="{DynamicResource Brush.Diff.Gutter}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding NewNo}" Width="42" TextAlignment="Right" Foreground="{DynamicResource Brush.Diff.Gutter}" Margin="0,0,10,0"/>
                        <TextBlock v:DiffText.Line="{Binding}" Margin="0,0,12,0"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
