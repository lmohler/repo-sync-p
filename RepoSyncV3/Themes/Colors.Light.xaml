<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#F1F4F6"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#D2DBE0"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#D2DBE0"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1B222B"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#516070"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#B5602A"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#A4521F"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#8C4A20"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#EFDCC7"/>

    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#D2DBE0"/>
    <SolidColorBrush x:Key="Brush.InputBorderFocus" Color="#B5602A"/>

    <SolidColorBrush x:Key="Brush.ButtonSecondaryBackground" Color="#E8EDEF"/>
    <SolidColorBrush x:Key="Brush.ButtonSecondaryBackgroundHover" Color="#E4E9EC"/>
    <SolidColorBrush x:Key="Brush.ButtonSecondaryBorder" Color="#D2DBE0"/>

    <SolidColorBrush x:Key="Brush.DataGridHeaderBackground" Color="#F1F4F6"/>
    <SolidColorBrush x:Key="Brush.DataGridRowAlt" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="Brush.DataGridRowHover" Color="#E8EDEF"/>
    <SolidColorBrush x:Key="Brush.DataGridSelected" Color="#EFDCC7"/>
    <SolidColorBrush x:Key="Brush.GridLines" Color="#E4E9EC"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#0F6B2A"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#7A5000"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#B4141F"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#7D8B98"/>

    <SolidColorBrush x:Key="Brush.LogBackground" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="Brush.LogBorder" Color="#D2DBE0"/>

    <!-- repo status -->
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="Brush.CardHover" Color="#E8EDEF"/>
    <SolidColorBrush x:Key="Brush.Status.Clean" Color="#13873A"/>
    <SolidColorBrush x:Key="Brush.Status.Dirty" Color="#B06A00"/>
    <SolidColorBrush x:Key="Brush.Status.Ahead" Color="#1F5FE0"/>
    <SolidColorBrush x:Key="Brush.Status.Behind" Color="#7340D8"/>
    <SolidColorBrush x:Key="Brush.Status.Diverged" Color="#B8440F"/>
    <SolidColorBrush x:Key="Brush.Status.Conflict" Color="#C21A26"/>
    <SolidColorBrush x:Key="Brush.Status.Unknown" Color="#7D8B98"/>

    <SolidColorBrush x:Key="Brush.Tint.Success" Color="#C8F2D3"/>
    <SolidColorBrush x:Key="Brush.Tint.Warning" Color="#FFE7A8"/>
    <SolidColorBrush x:Key="Brush.Tint.Error" Color="#FFD6D3"/>
    <SolidColorBrush x:Key="Brush.Tint.Info" Color="#CCE0FF"/>
    <SolidColorBrush x:Key="Brush.Tint.Purple" Color="#E6D8FF"/>
    <SolidColorBrush x:Key="Brush.Tint.Orange" Color="#FFDCC7"/>
    <SolidColorBrush x:Key="Brush.Tint.Neutral" Color="#E8EDEF"/>

    <SolidColorBrush x:Key="Brush.Text.Success" Color="#0A4F1F"/>
    <SolidColorBrush x:Key="Brush.Text.Warning" Color="#5E3B00"/>
    <SolidColorBrush x:Key="Brush.Text.Error" Color="#8A0A1E"/>
    <SolidColorBrush x:Key="Brush.Text.Info" Color="#033F8C"/>
    <SolidColorBrush x:Key="Brush.Text.Purple" Color="#4F2799"/>
    <SolidColorBrush x:Key="Brush.Text.Orange" Color="#7A2E05"/>

    <!-- diff -->
    <SolidColorBrush x:Key="Brush.Diff.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Diff.AddBackground" Color="#D3F8DD"/>
    <SolidColorBrush x:Key="Brush.Diff.AddText" Color="#0A4F1F"/>
    <SolidColorBrush x:Key="Brush.Diff.DeleteBackground" Color="#FFDCD8"/>
    <SolidColorBrush x:Key="Brush.Diff.DeleteText" Color="#6E0518"/>
    <SolidColorBrush x:Key="Brush.Diff.HunkBackground" Color="#CDEBFF"/>
    <SolidColorBrush x:Key="Brush.Diff.HunkText" Color="#033F8C"/>
    <SolidColorBrush x:Key="Brush.Diff.Text" Color="#1B222B"/>
    <SolidColorBrush x:Key="Brush.Diff.Gutter" Color="#7D8B98"/>
    <SolidColorBrush x:Key="Brush.Diff.AddWord" Color="#A6EBB8"/>
    <SolidColorBrush x:Key="Brush.Diff.DeleteWord" Color="#FFB3AB"/>
    <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#0550AE"/>
    <SolidColorBrush x:Key="Brush.Syntax.String" Color="#8A4B08"/>
    <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#6A737D"/>
    <SolidColorBrush x:Key="Brush.Syntax.Number" Color="#6F42C1"/>

</ResourceDictionary>
