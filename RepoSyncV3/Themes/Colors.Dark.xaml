<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#1B222A"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#232C35"/>
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#3B4854"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#3B4854"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E7EBEE"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A5B2BC"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#B5602A"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#C8733A"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#964E21"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#3E2E20"/>

    <SolidColorBrush x:Key="Brush.InputBackground" Color="#2B353F"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#3B4854"/>
    <SolidColorBrush x:Key="Brush.InputBorderFocus" Color="#C8733A"/>

    <SolidColorBrush x:Key="Brush.ButtonSecondaryBackground" Color="#2B353F"/>
    <SolidColorBrush x:Key="Brush.ButtonSecondaryBackgroundHover" Color="#33404B"/>
    <SolidColorBrush x:Key="Brush.ButtonSecondaryBorder" Color="#3B4854"/>

    <SolidColorBrush x:Key="Brush.DataGridHeaderBackground" Color="#1F272F"/>
    <SolidColorBrush x:Key="Brush.DataGridRowAlt" Color="#26303A"/>
    <SolidColorBrush x:Key="Brush.DataGridRowHover" Color="#2B353F"/>
    <SolidColorBrush x:Key="Brush.DataGridSelected" Color="#3E2E20"/>
    <SolidColorBrush x:Key="Brush.GridLines" Color="#3B4854"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFD166"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#788794"/>

    <SolidColorBrush x:Key="Brush.LogBackground" Color="#151B21"/>
    <SolidColorBrush x:Key="Brush.LogBorder" Color="#3B4854"/>

    <!-- repo status -->
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#1F272F"/>
    <SolidColorBrush x:Key="Brush.CardHover" Color="#2B353F"/>
    <SolidColorBrush x:Key="Brush.Status.Clean" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Brush.Status.Dirty" Color="#FFB938"/>
    <SolidColorBrush x:Key="Brush.Status.Ahead" Color="#5CA8FF"/>
    <SolidColorBrush x:Key="Brush.Status.Behind" Color="#C49BFF"/>
    <SolidColorBrush x:Key="Brush.Status.Diverged" Color="#FF8F4D"/>
    <SolidColorBrush x:Key="Brush.Status.Conflict" Color="#FF5C5C"/>
    <SolidColorBrush x:Key="Brush.Status.Unknown" Color="#95A3AF"/>

    <SolidColorBrush x:Key="Brush.Tint.Success" Color="#164A3A"/>
    <SolidColorBrush x:Key="Brush.Tint.Warning" Color="#4F3F14"/>
    <SolidColorBrush x:Key="Brush.Tint.Error" Color="#5C2228"/>
    <SolidColorBrush x:Key="Brush.Tint.Info" Color="#1E3D66"/>
    <SolidColorBrush x:Key="Brush.Tint.Purple" Color="#43306A"/>
    <SolidColorBrush x:Key="Brush.Tint.Orange" Color="#5A3018"/>
    <SolidColorBrush x:Key="Brush.Tint.Neutral" Color="#2B353F"/>

    <SolidColorBrush x:Key="Brush.Text.Success" Color="#8CF5CB"/>
    <SolidColorBrush x:Key="Brush.Text.Warning" Color="#FFD98A"/>
    <SolidColorBrush x:Key="Brush.Text.Error" Color="#FFB3B3"/>
    <SolidColorBrush x:Key="Brush.Text.Info" Color="#AFCFFF"/>
    <SolidColorBrush x:Key="Brush.Text.Purple" Color="#DCC4FF"/>
    <SolidColorBrush x:Key="Brush.Text.Orange" Color="#FFC19A"/>

    <!-- diff -->
    <SolidColorBrush x:Key="Brush.Diff.Background" Color="#151B21"/>
    <SolidColorBrush x:Key="Brush.Diff.AddBackground" Color="#1A4A2E"/>
    <SolidColorBrush x:Key="Brush.Diff.AddText" Color="#B8F5C8"/>
    <SolidColorBrush x:Key="Brush.Diff.DeleteBackground" Color="#5A2329"/>
    <SolidColorBrush x:Key="Brush.Diff.DeleteText" Color="#FFC2C2"/>
    <SolidColorBrush x:Key="Brush.Diff.HunkBackground" Color="#1E3358"/>
    <SolidColorBrush x:Key="Brush.Diff.HunkText" Color="#AFCFFF"/>
    <SolidColorBrush x:Key="Brush.Diff.Text" Color="#D6DDE2"/>
    <SolidColorBrush x:Key="Brush.Diff.Gutter" Color="#788794"/>
    <SolidColorBrush x:Key="Brush.Diff.AddWord" Color="#2E7D4A"/>
    <SolidColorBrush x:Key="Brush.Diff.DeleteWord" Color="#8E3640"/>
    <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#79B8FF"/>
    <SolidColorBrush x:Key="Brush.Syntax.String" Color="#F2C38B"/>
    <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#8B9AA6"/>
    <SolidColorBrush x:Key="Brush.Syntax.Number" Color="#D2A8FF"/>

</ResourceDictionary>
