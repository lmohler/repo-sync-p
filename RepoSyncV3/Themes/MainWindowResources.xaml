<!-- Styles and templates for the main window and its tabs (Views/Tabs). Merged in App.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RepoSyncV3.ViewModels"
                    xmlns:m="clr-namespace:RepoSyncV3.Models"
                    xmlns:s="clr-namespace:RepoSyncV3.Services"
                    xmlns:views="clr-namespace:RepoSyncV3.Views">
    <!-- color stripe per repo state: the text color of the matching notification banner -->
    <Style x:Key="StateStripe" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Unknown}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Clean}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Ahead}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Info}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Unpublished}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Info}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Dirty}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Warning}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Behind}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Purple}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Diverged}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Orange}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Conflict}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Error}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Error}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Error}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Missing}">
                <Setter Property="Background" Value="{DynamicResource Brush.Text.Error}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- state label pill: same tint + text colors as the notification banner (Pill style) -->
    <Style x:Key="StatePill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Tint.Neutral}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Clean}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Success}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Ahead}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Info}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Info}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Unpublished}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Info}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Info}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Dirty}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Warning}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Warning}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Behind}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Purple}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Purple}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Diverged}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Orange}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Orange}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Conflict}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Error}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RepoState.Missing}">
                <Setter Property="Background" Value="{DynamicResource Brush.Tint.Error}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Error}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LogLine" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Command}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Header}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Success}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Clean}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Dirty}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static m:LogLevel.Error}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Conflict}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- toolbar button with an icon and a label -->
    <DataTemplate x:Key="IconLabel">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,7,0"/>
            <!-- a presenter, not a TextBlock: a button may pass a panel (label + count) instead of a string -->
            <ContentPresenter Content="{Binding}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconLabel}"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- action-bar button: Uid = a NextStep.Action key; the button matching the repo's next step is highlighted.
         DataContext must be the RepoDetailViewModel (binds Repo.Next.Action). -->
    <Style x:Key="Tool.Step" TargetType="Button" BasedOn="{StaticResource Tool}">
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource AllEqual}">
                        <Binding Path="Uid" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="Repo.Next.Action"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tool.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="ContentTemplate" Value="{StaticResource IconLabel}"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <!-- sidebar filter chip with a count: Tag = the count; dimmed at 0 unless it is the active filter -->
    <Style x:Key="Chip.Count" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0"/>
                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Opacity" Value="0.5"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- "More" dropdown toggle: looks like Tool.Ghost, stays highlighted while its popup is open -->
    <Style x:Key="MoreToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" Margin="0,0,7,0"/>
                            <TextBlock Text="More" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="6,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ButtonSecondaryBackgroundHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ButtonSecondaryBackgroundHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconOnly" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <!-- workspace switcher tab: Tag = the workspace's brush (underline + tint when selected) -->
    <Style x:Key="WorkspaceTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource Brush.ButtonSecondaryBorder}" BorderThickness="1" CornerRadius="7" Padding="9,5,9,6">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Tint" Background="{TemplateBinding Tag}" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Bar" Background="{TemplateBinding Tag}" Height="3" CornerRadius="0,0,7,7" VerticalAlignment="Bottom" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ButtonSecondaryBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.12"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- one line on the home page; clicking it opens the repo on the right tab -->
    <DataTemplate x:Key="DashRow" DataType="vm:DashboardItem">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"
                    Command="{Binding DataContext.Dashboard.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                    ToolTip="Open this repo">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding WorkspaceBrush}" CornerRadius="2" Margin="0,1"/>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,8,0"/>
                            <Border CornerRadius="8" Padding="6,0,6,1" Background="{Binding WorkspaceTint}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WorkspaceName}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding WorkspaceBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Pill}" Tag="{Binding Tone}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Badge}"/>
                    </Border>
                </Grid>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource IconOnly}" Content="&#xE8A7;" VerticalAlignment="Center" AutomationProperties.Name="Open on the web" ToolTip="Open on the web"
                    Command="{Binding DataContext.Dashboard.OpenItemWebCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                    Visibility="{Binding Url, Converter={StaticResource Vis}}"/>
        </Grid>
    </DataTemplate>

    <!-- folder row of a file tree (Changes and History). The chevron and double-click / Left / Right fold it; in Changes,
         hovering shows Stage / Unstage / Discard for every file under it. -->
    <DataTemplate x:Key="FolderRow" DataType="s:FileTreeFolder">
        <Grid Background="Transparent" Margin="{Binding Depth, Converter={StaticResource TreeIndent}}" ToolTip="{Binding Path}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding IsExpanded}" Focusable="False" Cursor="Hand" Width="16" VerticalAlignment="Center"
                              AutomationProperties.Name="Expand or collapse folder">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="2,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                <!-- SVN send list only: tick / untick every sendable file in the folder (partial when some are) -->
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Send every file in this folder"
                          Visibility="{Binding IsCheckable, Converter={StaticResource Vis}}"/>
            </StackPanel>
            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding FileCount}" Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel x:Name="RowButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden">
                <Button x:Name="DiscardBtn" Style="{StaticResource IconOnly}" Content="&#xE7A7;" Visibility="Collapsed"
                        AutomationProperties.Name="Discard every change in this folder" ToolTip="Discard every change in this folder"
                        Command="{Binding DataContext.Detail.DiscardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button x:Name="StageBtn" Style="{StaticResource IconOnly}" Content="&#xE710;" Visibility="Collapsed"
                        AutomationProperties.Name="Stage this folder" ToolTip="Stage this folder"
                        Command="{Binding DataContext.Detail.StageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button x:Name="UnstageBtn" Style="{StaticResource IconOnly}" Content="&#xE738;" Visibility="Collapsed"
                        AutomationProperties.Name="Unstage this folder" ToolTip="Unstage this folder"
                        Command="{Binding DataContext.Detail.UnstageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="RowButtons" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="RowButtons" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Staged}" Value="False">
                <Setter TargetName="StageBtn" Property="Visibility" Value="Visible"/>
                <Setter TargetName="DiscardBtn" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Staged}" Value="True">
                <Setter TargetName="UnstageBtn" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- file row (history commit files); indented under its folder in tree view -->
    <DataTemplate x:Key="CommitFileRow" DataType="m:CommitFile">
        <StackPanel Orientation="Horizontal" Margin="{Binding TreeDepth, Converter={StaticResource TreeIndent}}">
            <Border Style="{StaticResource FileBadge}" Tag="{Binding Code}">
                <TextBlock Text="{Binding Code}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding FileName}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                       Visibility="{Binding TreeDepth, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
        </StackPanel>
    </DataTemplate>

    <!-- file row (changes lists); indented under its folder in tree view, where the folder text is dropped -->
    <DataTemplate x:Key="FileRow" DataType="m:FileChange">
        <Grid Background="Transparent" ToolTip="{Binding Label}" Margin="{Binding TreeDepth, Converter={StaticResource TreeIndent}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource FileBadge}" Tag="{Binding Code}">
                <TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- a long name trims with an ellipsis; the folder trims first -->
            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding FileName}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center"
                           Visibility="{Binding TreeDepth, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
            </DockPanel>
            <StackPanel x:Name="RowButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden">
                <Button Style="{StaticResource IconOnly}" Content="&#xE8E5;" AutomationProperties.Name="Open in editor" ToolTip="Open in editor"
                        Command="{Binding DataContext.Detail.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button x:Name="DiscardBtn" Style="{StaticResource IconOnly}" Content="&#xE7A7;" AutomationProperties.Name="Discard changes" ToolTip="Discard changes"
                        Command="{Binding DataContext.Detail.DiscardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button x:Name="StageBtn" Style="{StaticResource IconOnly}" Content="&#xE710;" AutomationProperties.Name="Stage (double-click works too)" ToolTip="Stage (double-click works too)"
                        Command="{Binding DataContext.Detail.StageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                <Button x:Name="UnstageBtn" Style="{StaticResource IconOnly}" Content="&#xE738;" AutomationProperties.Name="Unstage (double-click works too)" ToolTip="Unstage (double-click works too)"
                        Command="{Binding DataContext.Detail.UnstageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="RowButtons" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="RowButtons" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Staged}" Value="True">
                <Setter TargetName="StageBtn" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="DiscardBtn" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Staged}" Value="False">
                <Setter TargetName="UnstageBtn" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- SVN tab: a file the work branch changed vs SVN, ticked to send -->
    <DataTemplate x:Key="SvnFileRow" DataType="vm:SvnFileItem">
        <Grid Margin="{Binding TreeDepth, Converter={StaticResource TreeIndent}}" Background="Transparent" ToolTip="{Binding Path}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSend}"
                      VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Send this file (Send ticked)"/>
            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding FileName}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding TreeDepth, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
            </DockPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding CommittedText}" Foreground="{DynamicResource Brush.Text.Warning}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- SVN tab: a path changed in a revision (A / M / D / R) -->
    <DataTemplate x:Key="SvnPathRow" DataType="s:SvnChangedPath">
        <StackPanel Orientation="Horizontal" Margin="{Binding TreeDepth, Converter={StaticResource TreeIndent}}" ToolTip="{Binding Text}">
            <Border Style="{StaticResource FileBadge}" Tag="{Binding Action}">
                <TextBlock Text="{Binding Action}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding FileName}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,0,8,0"
                       Visibility="{Binding TreeDepth, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
            <TextBlock Text="{Binding CopyFrom, StringFormat='from {0}'}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                       Visibility="{Binding CopyFrom, Converter={StaticResource Vis}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- file tree lists: folder rows and file rows in one ListBox -->
    <views:FileTreeTemplateSelector x:Key="ChangeTreeRows" FolderTemplate="{StaticResource FolderRow}" FileTemplate="{StaticResource FileRow}"/>
    <views:FileTreeTemplateSelector x:Key="SvnFileTreeRows" FolderTemplate="{StaticResource FolderRow}" FileTemplate="{StaticResource SvnFileRow}"/>
    <views:FileTreeTemplateSelector x:Key="SvnPathTreeRows" FolderTemplate="{StaticResource FolderRow}" FileTemplate="{StaticResource SvnPathRow}"/>
    <views:FileTreeTemplateSelector x:Key="CommitTreeRows" FolderTemplate="{StaticResource FolderRow}" FileTemplate="{StaticResource CommitFileRow}"/>
</ResourceDictionary>
