<Window x:Class="RepoSyncV3.Views.MergeRequestReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="1240" Height="780" SizeToContent="Manual"
        ResizeMode="CanResize" Title="Review">
    <Grid Margin="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Heading}" FontSize="15" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Files" SelectionChanged="Files_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}" Width="16" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <ListBox x:Name="Diff" Grid.Column="2" Style="{StaticResource DiffList}" MouseDoubleClick="Diff_DoubleClick"
                     ToolTip="Double-click a line to comment on it"/>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionLabel}" Text="COMMENTS"/>
                <ScrollViewer x:Name="CommentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Comments">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Created, Mode=OneWay, StringFormat='  {0:yyyy-MM-dd HH:mm}'}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Where}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Accent}"
                                                   Visibility="{Binding Where, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBox x:Name="NewComment" Grid.Row="2" Style="{StaticResource TextBox.Multiline}" Height="70" Margin="0,6,0,0"
                         ToolTip="Markdown is fine. Ctrl+Enter posts."/>
                <Button Grid.Row="3" Content="Post comment" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" Margin="0,6,0,0" Click="Post_Click"/>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open on the web" Click="Web_Click" Margin="0,0,8,0"/>
            <Button Content="Close" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
