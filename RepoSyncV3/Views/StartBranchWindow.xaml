<Window x:Class="RepoSyncV3.Views.StartBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="540" Title="Start a branch">
    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="Start a feature branch"/>
        <TextBlock x:Name="RepoText" Style="{StaticResource Text.Muted}" Margin="0,4,0,14"/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="WHAT ARE YOU WORKING ON?"/>
        <TextBox x:Name="NameBox" TextChanged="Inputs_Changed"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="1,4,0,0" Text="A few words or a ticket number, e.g. 'login timeout' or '1234 fix export'."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="BRANCH NAME PATTERN" Margin="1,14,0,6"/>
        <TextBox x:Name="PatternBox" TextChanged="Inputs_Changed"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="1,4,0,0" Text="{}{name} = what you typed, {user} = your git user name. Saved for next time."/>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="{DynamicResource Brush.AccentSubtle}" BorderThickness="0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="NEW BRANCH"/>
                <TextBlock x:Name="PreviewText" FontFamily="{StaticResource Font.Mono}" FontSize="13.5" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionLabel}" Text="START FROM" Margin="1,14,0,6"/>
        <ComboBox x:Name="StartPointBox"/>
        <TextBlock x:Name="NoRemoteNote" Style="{StaticResource Text.Muted}" Margin="1,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                   Text="This repo has no remote, so the branch stays local. Add a remote later to publish it."/>
        <TextBlock x:Name="DirtyNote" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Warning}" Margin="1,8,0,0" Visibility="Collapsed"
                   Text="You have uncommitted changes - they come along to the new branch."/>

        <CheckBox x:Name="PublishBox" Content="Publish to GitLab right away (push -u)" Margin="0,14,0,0" IsChecked="True"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="OkButton" Content="Create branch" IsDefault="True" Style="{StaticResource Button.Primary}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
