<Window x:Class="RepoSyncV3.Views.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="640" Title="Repo health">
    <StackPanel Margin="14,12">
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Heading}" FontSize="15"/>
        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Pill}" Tag="{Binding Tone}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="12.5"/>
                                <TextBlock Text="{Binding Detail}" FontWeight="Normal" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Clean up branches..." Click="Cleanup_Click" Margin="0,0,8,0"/>
            <Button Content="Compact (git gc)" Click="Gc_Click" Margin="0,0,8,0" ToolTip="Packs loose objects and removes unreachable ones older than two weeks"/>
            <Button Content="Close" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
