<Window x:Class="RepoSyncV3.Views.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="760" SizeToContent="Manual" Height="720" ResizeMode="CanResize"
        Title="Clone">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="Clone a repository"/>
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,12" Text="Pick one of your GitHub or GitLab projects, or paste a clone URL below."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="HostBox" SelectionChanged="Host_Changed" DisplayMemberPath="Label" ToolTip="Account to browse"/>
            <TextBox x:Name="FilterBox" Grid.Column="2" TextChanged="Filter_Changed" ToolTip="Filter projects"/>
            <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0" Click="Reload_Click" ToolTip="Reload projects">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListBox x:Name="ProjectList" SelectionChanged="Project_Changed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding PathWithNamespace}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ListMessage" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="30"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource SectionLabel}" Text="CLONE URL"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" TextChanged="Url_Changed"/>
                <CheckBox x:Name="SshBox" Grid.Column="1" Content="SSH" Margin="10,0,0,0" VerticalAlignment="Center" Click="Project_Changed"/>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionLabel}" Text="PROFILE"/>
                <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="CLONE INTO"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="WorkspaceBox" DisplayMemberPath="Name" SelectionChanged="Workspace_Changed"
                          ToolTip="The profile the repo is listed in; the clone gets this profile's git identity"/>
                <TextBox x:Name="RootBox" Grid.Column="2" TextChanged="Url_Changed"/>
                <Button Grid.Column="3" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
            <TextBlock x:Name="TargetText" Style="{StaticResource Text.Muted}" Margin="1,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="OkButton" Content="Clone" IsDefault="True" Style="{StaticResource Button.Primary}" MinWidth="90" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
