<Window x:Class="RepoSyncV3.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent}"
        Title="Command palette" Deactivated="Window_Deactivated">
    <StackPanel Margin="8">
        <TextBox x:Name="Query" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" FontSize="14"
                 ToolTip="Type a few letters of a repo, branch or action (fuzzy). Up/Down or PgUp/PgDn to pick, Enter to run, Esc to close."/>
        <ListBox x:Name="Results" Margin="0,6,0,0" MaxHeight="420" AutomationProperties.Name="Palette results" MouseDoubleClick="Results_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Group}" Style="{StaticResource Text.Muted}" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}"
                                   MinWidth="96" TextAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="CountText" Style="{StaticResource Text.Muted}" Margin="2,6,0,0"/>
    </StackPanel>
</Window>
