<Window x:Class="RepoSyncV3.Views.ScanResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="760" SizeToContent="Manual" Height="520" ResizeMode="CanResize"
        Title="Add repositories">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Heading}" FontSize="15" Text="Add repositories"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,10"
                   Text="Git repositories found. Tick the ones to add:"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- column headers, shown with the repo name column -->
                <Grid x:Name="HeaderRow" Margin="0,0,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="31"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource SectionLabel}" Text="REPO" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="PATH"/>
                </Grid>
                <ListBox x:Name="ItemsList" Grid.Row="1">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- the columns sit inside the CheckBox so clicking anywhere on the row ticks it -->
                            <CheckBox IsChecked="{Binding Checked}" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,16,0"
                                               Visibility="{Binding HasName, Converter={StaticResource Vis}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="All" Style="{StaticResource Button.Ghost}" Click="All_Click"/>
                <Button Content="None" Style="{StaticResource Button.Ghost}" Click="None_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
                <Button x:Name="OkButton" Content="Add" IsDefault="True" Style="{StaticResource Button.Primary}" MinWidth="90" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
