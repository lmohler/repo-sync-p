<Window x:Class="RepoSyncV3.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="760" Title="Keyboard shortcuts">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="Keyboard shortcuts" Margin="0,0,0,6"/>
        <TextBox x:Name="FilterBox" Grid.Row="1" Margin="0,0,0,10" TextChanged="Filter_Changed" AutomationProperties.Name="Filter shortcuts"
                 ToolTip="Type to filter"/>

        <!-- two columns of groups; each group is a heading plus key / action rows -->
        <ScrollViewer Grid.Row="2" MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,16,14" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Title}"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Text="Every action is also in the command palette (Ctrl+K)."/>
            <Button HorizontalAlignment="Right" Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource Button.Primary}" MinWidth="80"/>
        </Grid>
    </Grid>
</Window>
