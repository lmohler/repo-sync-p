<Window x:Class="RepoSyncV3.Views.CommitAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RepoSyncV3.ViewModels"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="900" Height="640" ResizeMode="CanResizeWithGrip" Title="Commit all">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="Commit all"/>
            <TextBlock x:Name="ScopeText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,10">
            <Button DockPanel.Dock="Right" Content="Use for all ticked" Margin="8,0,0,0" Click="UseForAll_Click"
                    ToolTip="Put this message on every ticked repo (each keeps its branch's ticket prefix)"/>
            <TextBlock DockPanel.Dock="Left" Text="One message for all" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="AllMessageBox" AutomationProperties.Name="One message for all ticked repos"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CommitAllRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}" VerticalAlignment="Top" Margin="0,3,8,0"
                                          AutomationProperties.Name="{Binding Name}"/>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Branch, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ChangesText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}"
                                             AutomationProperties.Name="Commit message"/>
                                    <TextBlock Text="{Binding BlockedReason}" Foreground="{DynamicResource Brush.Text.Error}" FontSize="11.5" Margin="2,3,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding BlockedReason, Converter={StaticResource Vis}}"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Brush.Text.Warning}" FontSize="11.5" Margin="2,3,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Note, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <CheckBox x:Name="PushBox" Content="Push after committing (runs each repo's pre-push check)" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
                <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource Button.Primary}" MinWidth="120" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
