<Window x:Class="RepoSyncV3.Views.FileHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:RepoSyncV3.Models"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="1100" Height="700" Title="File History">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="File History"/>
                <TextBlock x:Name="FileText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <CheckBox x:Name="IgnoreWsBox" Content="Ignore whitespace (-w)" HorizontalAlignment="Right" VerticalAlignment="Center" Click="IgnoreWs_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CommitGrid" Style="{StaticResource Grid.List}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      SelectionChanged="CommitGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hash" Binding="{Binding ShortHash}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="110"/>
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <ListBox x:Name="DiffList" Grid.Column="2" Style="{StaticResource DiffList}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy hash" Click="CopyHash_Click" Margin="0,0,8,0" MinWidth="90"/>
            <Button Content="Close" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>

