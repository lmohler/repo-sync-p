<Window x:Class="RepoSyncV3.Views.StandupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="680" Height="560" ResizeMode="CanResizeWithGrip" Title="What I did">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="What I did"/>
            <TextBlock x:Name="ScopeText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <RadioButton x:Name="LastWorkdayRadio" Style="{StaticResource Chip}" GroupName="range" Content="Since last workday" IsChecked="True" Checked="Range_Changed"/>
            <RadioButton x:Name="TodayRadio" Style="{StaticResource Chip}" GroupName="range" Content="Today" Checked="Range_Changed"/>
            <RadioButton x:Name="WeekRadio" Style="{StaticResource Chip}" GroupName="range" Content="Last 7 days" Checked="Range_Changed"/>
        </StackPanel>
        <TextBox x:Name="OutputBox" Grid.Row="2" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalContentAlignment="Top"
                 AutomationProperties.Name="Summary of your commits"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="CopyButton" Content="Copy" IsDefault="True" Style="{StaticResource Button.Primary}" MinWidth="90" Click="Copy_Click"/>
        </StackPanel>
    </Grid>
</Window>
