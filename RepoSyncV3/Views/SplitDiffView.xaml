<UserControl x:Class="RepoSyncV3.Views.SplitDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:RepoSyncV3.Models"
             xmlns:v="clr-namespace:RepoSyncV3.Views">
    <!-- Two panes (old | new), each with its own horizontal scroll; vertical scroll and selection are synced in code-behind. -->
    <UserControl.Resources>
        <Style x:Key="Pane" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Diff.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- Always visible on both panes so their viewport heights match and the synced offsets line up. -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <!-- F7 / Shift+F7 (or Alt+Down / Alt+Up) jump between change blocks; the other pane follows the selection -->
            <Setter Property="v:DiffNav.IsEnabled" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <ContentPresenter/>
                                        <Border x:Name="Sel" Background="{DynamicResource Brush.DataGridSelected}" Opacity="0.55" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LeftRow" DataType="m:SideBySideDiffRow">
            <Grid>
                <Border Background="{DynamicResource Brush.Diff.HunkBackground}" Padding="8,1" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding HeaderText}" Foreground="{DynamicResource Brush.Diff.HunkText}" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="Col" Background="Transparent" Padding="4,1" Visibility="{Binding IsHeader, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LeftNo}" Width="42" TextAlignment="Right" Foreground="{DynamicResource Brush.Diff.Gutter}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="Txt" v:DiffText.Line="{Binding LeftLine}" Foreground="{DynamicResource Brush.Diff.Text}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LeftKind}" Value="{x:Static m:DiffKind.Delete}">
                    <Setter TargetName="Col" Property="Background" Value="{DynamicResource Brush.Diff.DeleteBackground}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.Diff.DeleteText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLeft}" Value="False">
                    <Setter TargetName="Col" Property="Background" Value="{DynamicResource Brush.Diff.HunkBackground}"/>
                    <Setter TargetName="Col" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RightRow" DataType="m:SideBySideDiffRow">
            <Grid>
                <Border Background="{DynamicResource Brush.Diff.HunkBackground}" Padding="8,1" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding HeaderText}" Foreground="{DynamicResource Brush.Diff.HunkText}" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="Col" Background="Transparent" Padding="4,1" Visibility="{Binding IsHeader, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RightNo}" Width="42" TextAlignment="Right" Foreground="{DynamicResource Brush.Diff.Gutter}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="Txt" v:DiffText.Line="{Binding RightLine}" Foreground="{DynamicResource Brush.Diff.Text}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RightKind}" Value="{x:Static m:DiffKind.Add}">
                    <Setter TargetName="Col" Property="Background" Value="{DynamicResource Brush.Diff.AddBackground}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.Diff.AddText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRight}" Value="False">
                    <Setter TargetName="Col" Property="Background" Value="{DynamicResource Brush.Diff.HunkBackground}"/>
                    <Setter TargetName="Col" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="80"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="80"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="LeftList" Style="{StaticResource Pane}" ItemTemplate="{StaticResource LeftRow}"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.ScrollChanged="Pane_ScrollChanged" SelectionChanged="Pane_SelectionChanged"/>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the panes"/>
        <ListBox x:Name="RightList" Grid.Column="2" Style="{StaticResource Pane}" ItemTemplate="{StaticResource RightRow}"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.ScrollChanged="Pane_ScrollChanged" SelectionChanged="Pane_SelectionChanged"/>
    </Grid>
</UserControl>
