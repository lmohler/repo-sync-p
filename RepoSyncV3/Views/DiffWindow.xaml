<Window x:Class="RepoSyncV3.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:RepoSyncV3.Views"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="True"
        Width="1300" Height="800" MinWidth="600" MinHeight="300" Title="Diff">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Heading}" FontSize="15" FontFamily="{StaticResource Font.Mono}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <CheckBox x:Name="SplitCheck" Content="Split diff" HorizontalAlignment="Right" VerticalAlignment="Center"
                      ToolTip="Side-by-side split diff view" Checked="SplitCheck_Changed" Unchecked="SplitCheck_Changed"/>
        </Grid>

        <ListBox x:Name="UnifiedBox" Grid.Row="1" Style="{StaticResource DiffList}"/>
        <v:SplitDiffView x:Name="SplitBox" Grid.Row="1" Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" IsCancel="True" MinWidth="80" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
