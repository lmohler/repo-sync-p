<Window x:Class="RepoSyncV3.Views.IdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="560" Title="Check your identity">
    <StackPanel Margin="20,18">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" Foreground="{DynamicResource Brush.Status.Conflict}" Margin="0,0,10,0"/>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Text.Heading}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SectionLabel}" Text="WOULD COMMIT AS" Margin="0,0,14,4" VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentText" Grid.Column="1" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Text.Error}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Style="{StaticResource SectionLabel}" x:Name="ExpectedLabel" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ExpectedText" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Text.Success}" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Margin="0,18,0,0">
            <Button x:Name="UseButton" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Use_Click" Margin="0,0,0,6"/>
            <Button x:Name="MoveButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Move_Click" Margin="0,0,0,6"/>
            <Button x:Name="ProceedButton" Style="{StaticResource Button.Danger}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Proceed_Click" Margin="0,0,0,6"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Change how this check behaves in Settings > Profiles. Move this repo to another profile any time: right-click its card > Move to profile, or click the profile pill in the repo header."/>
    </StackPanel>
</Window>
