<UserControl x:Class="RepoSyncV3.Views.Tabs.OverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RepoSyncV3.ViewModels"
             xmlns:m="clr-namespace:RepoSyncV3.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,6">
            <!-- next step -->
            <Border Style="{StaticResource Pill}" Tag="{Binding Repo.Next.Tone}" CornerRadius="10" Padding="12,8" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="22" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NEXT STEP" FontSize="11" FontWeight="Bold" Opacity="0.8"/>
                        <TextBlock Text="{Binding Repo.Next.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Repo.Next.Detail}" FontSize="13" FontWeight="Normal" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Button.Primary}" VerticalAlignment="Center" Margin="16,0,0,0"
                            Content="{Binding Repo.Next.Button}" Command="{Binding DataContext.NextStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Repo}"
                            Visibility="{Binding Repo.Next.Button, Converter={StaticResource Vis}}"/>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="-6,6,-6,0">
                <!-- branch -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="BRANCH"/>
                        <TextBlock Text="{Binding Repo.Branch}" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Repo.TrackingText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" Foreground="{DynamicResource Brush.Status.Ahead}" FontSize="15"/>
                            <TextBlock Text="{Binding Repo.Ahead}" Style="{StaticResource Text.Big}" Margin="4,0,4,0"/>
                            <TextBlock Text="to push" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="0,0,18,5"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" Foreground="{DynamicResource Brush.Status.Behind}" FontSize="15"/>
                            <TextBlock Text="{Binding Repo.Behind}" Style="{StaticResource Text.Big}" Margin="4,0,4,0"/>
                            <TextBlock Text="to pull" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Repo.LastFetchText}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- working tree -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="WORKING TREE"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Repo.ChangeCount}" Style="{StaticResource Text.Big}"/>
                            <TextBlock Text="uncommitted change(s)" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0">
                            <Run Text="{Binding Repo.StagedCount, Mode=OneWay}"/><Run Text=" staged  ·  "/><Run Text="{Binding Repo.UnstagedCount, Mode=OneWay}"/><Run Text=" not staged ("/><Run Text="{Binding Repo.UntrackedCount, Mode=OneWay}"/><Run Text=" new)"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Visibility="{Binding StashCount, Converter={StaticResource Vis}}">
                            <Run Text="{Binding StashCount, Mode=OneWay}"/><Run Text=" stash(es) put aside"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Repo.InProgressText}" Foreground="{DynamicResource Brush.Status.Conflict}" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Visibility="{Binding Repo.InProgress, Converter={StaticResource Vis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Review changes" Command="{Binding GoToTabCommand}" CommandParameter="1" Margin="0,0,6,0"/>
                            <Button Content="Stashes" Command="{Binding GoToTabCommand}" CommandParameter="6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- vs default -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}">
                            <Run Text="COMPARED WITH "/><Run Text="{Binding Repo.DefaultRef, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="This is the default branch." Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Visibility="{Binding Repo.OnDefaultBranch, Converter={StaticResource Vis}}"/>
                        <StackPanel Visibility="{Binding Repo.IsFeatureBranch, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Repo.AheadOfDefault}" Style="{StaticResource Text.Big}" Foreground="{DynamicResource Brush.Status.Ahead}"/>
                                <TextBlock Text="your commits" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,18,5"/>
                                <TextBlock Text="{Binding Repo.BehindDefault}" Style="{StaticResource Text.Big}" Foreground="{DynamicResource Brush.Status.Behind}"/>
                                <TextBlock Text="{Binding Repo.NewOnDefaultText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="{Binding Repo.UpdateFromDefaultHint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Update now" Command="{Binding DataContext.UpdateFromDefaultCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,6,0"/>
                                <Button Content="{Binding Repo.ServerName}" ContentStringFormat="Compare on {0}" Command="{Binding CompareCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="-6,0,-6,0">
                <!-- merge request -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Repo.MrHeading}"/>
                        <StackPanel Visibility="{Binding Repo.HasMergeRequest, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Pill.MergeRequest}" Tag="{Binding Repo.MrKind}">
                                    <TextBlock Text="{Binding Repo.MergeRequest.Readiness}"/>
                                </Border>
                                <TextBlock Text="{Binding Repo.MergeRequest.Reference}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Repo.MergeRequest.Title}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Repo.MergeRequest.MergeStatusText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Repo.MergeRequest.Branches}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{Binding Repo.ServerName}" ContentStringFormat="Open on {0}" Command="{Binding OpenMergeRequestCommand}" CommandParameter="{Binding Repo.MergeRequest}" Margin="0,0,6,0"/>
                                <Button Content="{Binding Repo.MrsTerm}" ContentStringFormat="{}{0} tab" Command="{Binding GoToTabCommand}" CommandParameter="4"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Repo.HasMergeRequest, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="{Binding Repo.NoMrText}"/>
                            <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Warning}" Margin="0,4,0,0"
                                       Text="{Binding Repo.TokenHint}"
                                       Visibility="{Binding Repo.HasToken, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            <Button Content="{Binding Repo.CreateMrLongText}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding DataContext.CreateMergeRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding Repo.IsFeatureBranch, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- pipeline -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding Repo.PipelineHeading}"/>
                        <StackPanel Visibility="{Binding Repo.HasPipeline, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Dot.Pipeline}" Tag="{Binding Repo.PipelineKind}" Width="14" Height="14" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Repo.Pipeline.Label}" Style="{StaticResource Text.Big}" FontSize="20"/>
                                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="10,0,0,4">
                                    <Run Text="#"/><Run Text="{Binding Repo.Pipeline.Id, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Repo.Pipeline.ShortSha, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Repo.Pipeline.UpdatedAt, Mode=OneWay, Converter={StaticResource Ago}}"/>
                                </TextBlock>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding FailedJobs}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ForgeJob">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" Foreground="{DynamicResource Brush.Status.Conflict}" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Stage}" Style="{StaticResource Text.Muted}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Jobs &amp; logs" Command="{Binding GoToTabCommand}" CommandParameter="5" Margin="0,0,6,0"/>
                                <Button Content="{Binding Repo.ServerName}" ContentStringFormat="Open on {0}" Command="{Binding OpenPipelineCommand}" CommandParameter="{Binding Repo.Pipeline}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Text="No pipeline has run on this branch."
                                   Visibility="{Binding Repo.HasPipeline, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        <TextBlock Text="{Binding Repo.ServerError}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Error}" Margin="0,6,0,0"
                                   Visibility="{Binding Repo.ServerError, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- recent commits -->
            <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="RECENT COMMITS"/>
                        <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Content="Full history" Command="{Binding GoToTabCommand}" CommandParameter="3"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentCommits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:CommitInfo">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ShortHash}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Tag="info" Margin="8,0" Visibility="{Binding IsUnpushed, Converter={StaticResource Vis}}">
                                        <TextBlock Text="not pushed"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Date, Converter={StaticResource Ago}}" ToolTip="{Binding Date, Converter={StaticResource Exact}}" Style="{StaticResource Text.Muted}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
