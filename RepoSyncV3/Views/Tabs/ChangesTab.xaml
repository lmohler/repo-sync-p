<UserControl x:Class="RepoSyncV3.Views.Tabs.ChangesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RepoSyncV3.ViewModels"
             xmlns:m="clr-namespace:RepoSyncV3.Models"
             xmlns:views="clr-namespace:RepoSyncV3.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" MinWidth="300"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="90"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="70"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- merge / rebase in progress -->
            <Border Style="{StaticResource Pill}" Tag="error" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                    Visibility="{Binding Repo.InProgress, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Repo.InProgressText}" FontSize="13"/>
                    <TextBlock FontWeight="Normal" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8"
                               Text="Resolve each conflicted file below (Keep mine / Take theirs, or edit it and mark it resolved), then Continue. Abort puts everything back."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Continue" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}" Margin="0,0,6,0"/>
                        <Button Content="Abort" Style="{StaticResource Button.Danger}" Command="{Binding AbortCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- conflicts -->
            <StackPanel Grid.Row="1" Visibility="{Binding Conflicted.Count, Converter={StaticResource Vis}}" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Brush.Status.Conflict}">
                    <Run Text="CONFLICTS ("/><Run Text="{Binding Conflicted.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <ListBox x:Name="ConflictList" ItemsSource="{Binding Conflicted}" MaxHeight="170" SelectionChanged="ChangeList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="m:FileChange">
                            <StackPanel>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileRow}"/>
                                <WrapPanel Margin="26,4,0,2">
                                    <Button Content="Resolve..." Style="{StaticResource Button.Primary}" Padding="8,3" Margin="0,0,4,0"
                                            ToolTip="Pick mine / theirs / both for each conflict in this file"
                                            Command="{Binding DataContext.Detail.ResolveConflictCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Keep mine" Style="{StaticResource Button.Toolbar}" Padding="8,3" Margin="0,0,4,0"
                                            Command="{Binding DataContext.Detail.KeepMineCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Take theirs" Style="{StaticResource Button.Toolbar}" Padding="8,3" Margin="0,0,4,0"
                                            Command="{Binding DataContext.Detail.TakeTheirsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Edit" Style="{StaticResource Button.Toolbar}" Padding="8,3" Margin="0,0,4,0"
                                            Command="{Binding DataContext.Detail.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <Button Content="Mark resolved" Style="{StaticResource Button.Toolbar}" Padding="8,3"
                                            Command="{Binding DataContext.Detail.MarkResolvedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- unstaged -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="1,0,0,0">
                    <Run Text="CHANGES ("/><Run Text="{Binding Unstaged.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Folders" IsChecked="{Binding IsFileTree}" VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Group the changed files by folder (also in History). Double-click or Left / Right folds a folder."/>
                    <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE7A7;" Content="Discard all" Command="{Binding DiscardAllCommand}"/>
                    <Button views:ShortcutTip.Id="stage-all" Style="{StaticResource Tool.Ghost}" Tag="&#xE710;" Content="Stage all" Command="{Binding StageAllCommand}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox x:Name="UnstagedList" ItemsSource="{Binding UnstagedTree.Items}" ItemTemplateSelector="{StaticResource ChangeTreeRows}"
                             SelectionChanged="ChangeList_SelectionChanged" MouseDoubleClick="UnstagedList_DoubleClick" PreviewKeyDown="TreeList_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Stage" Command="{Binding StageCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Discard..." Command="{Binding DiscardCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Add to .gitignore">
                                    <MenuItem Header="Ignore this exact file" Command="{Binding IgnoreFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Ignore this file type (*.ext)" Command="{Binding IgnoreExtCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Ignore this folder" Command="{Binding IgnoreFolderCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="View file history..." Command="{Binding ViewFileHistoryCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Git blame..." Command="{Binding BlameCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Open in editor" Command="{Binding OpenFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Repo.ChangeCount, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Status.Clean}"/>
                        <TextBlock Text="Working tree clean" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- staged -->
            <Grid Grid.Row="4" Margin="0,10,0,4">
                <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="1,0,0,0">
                    <Run Text="STAGED ("/><Run Text="{Binding Staged.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE738;" Content="Unstage all" Command="{Binding UnstageAllCommand}" HorizontalAlignment="Right"/>
            </Grid>
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="4">
                <ListBox x:Name="StagedList" ItemsSource="{Binding StagedTree.Items}" ItemTemplateSelector="{StaticResource ChangeTreeRows}"
                         SelectionChanged="ChangeList_SelectionChanged" MouseDoubleClick="StagedList_DoubleClick" PreviewKeyDown="TreeList_PreviewKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Unstage" Command="{Binding UnstageCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="View file history..." Command="{Binding ViewFileHistoryCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Git blame..." Command="{Binding BlameCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Open in editor" Command="{Binding OpenFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>

            <!-- commit -->
            <StackPanel Grid.Row="6" Margin="0,10,0,0">
                <Border Style="{StaticResource Pill}" Tag="error" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        Visibility="{Binding Repo.IdentityMismatch, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Repo.IdentityProblem}" TextWrapping="Wrap" FontWeight="Normal" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Fix" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DataContext.FixIdentityCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Repo}"/>
                    </Grid>
                </Border>
                <TextBox x:Name="CommitBox" Style="{StaticResource TextBox.Multiline}" Height="72" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Auto" ToolTip="Commit message (Ctrl+Enter commits)" PreviewKeyDown="CommitBox_PreviewKeyDown"
                         AutomationProperties.Name="Commit message"/>
                <TextBlock Text="{Binding SubjectHint}" FontSize="11" Margin="2,3,0,0" TextWrapping="Wrap"
                           Visibility="{Binding SubjectHint, Converter={StaticResource Vis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubjectTone}" Value="warning">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SubjectTone}" Value="error">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Error}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- message options, then the undo-ish actions on their own line: the column is too narrow for both side by side -->
                <StackPanel Margin="0,6,0,0">
                    <WrapPanel>
                        <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE945;" Content="Suggest" Command="{Binding SuggestMessageCommand}" ToolTip="Write a message from the changed file names"/>
                        <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE8A5;" Content="Template" Command="{Binding UseTemplateCommand}" ToolTip="Fill in git's commit.template for this repo"
                                Visibility="{Binding HasTemplate, Converter={StaticResource Vis}}"/>
                        <CheckBox Content="Amend last" IsChecked="{Binding Amend}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Add to the previous commit instead (only if not pushed)"/>
                        <CheckBox IsChecked="{Binding UseTicketPrefix}" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Visibility="{Binding HasTicket, Converter={StaticResource Vis}}" ToolTip="Start the commit message with the ticket key from the branch name">
                            <TextBlock><Run Text="Prefix "/><Run Text="{Binding Ticket, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </CheckBox>
                    </WrapPanel>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,2,0,0">
                        <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE74A;" Content="Force push" Command="{Binding ForcePushCommand}" Margin="0,0,6,0" ToolTip="Push with --force-with-lease (use after amending or rebasing)"/>
                        <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE7A7;" Content="Undo last" Command="{Binding UndoLastCommitCommand}" ToolTip="Take the last (unpushed) commit back; its changes stay staged"/>
                        <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE81C;" Content="Recover..." Command="{Binding RecoverCommand}" Margin="6,0,0,0"
                                ToolTip="Undo a reset, rebase, amend or deleted commit using git's reflog"/>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Text.Muted}" Margin="2,4,0,6"/>
                <UniformGrid Columns="2">
                    <Button Content="Commit" Command="{Binding CommitCommand}" Margin="0,0,4,0"/>
                    <Button Content="Commit &amp; push" Style="{StaticResource Button.Primary}" Command="{Binding CommitPushCommand}" Margin="4,0,0,0"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

        <!-- diff -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- file on its own line (name first, folder trims first, full path in the tooltip); the controls wrap below it -->
            <StackPanel Margin="0,0,0,6">
                <DockPanel Margin="0,0,0,2" MinHeight="22" Background="Transparent" ToolTip="{Binding SelectedChange.Path}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedChange.FileName}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding SelectedChange, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding SelectedChange.Label}"/>
                    </Border>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Tag="success" Margin="4,0,0,0" Visibility="{Binding SelectedChange.Staged, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                        <TextBlock Text="staged"/>
                    </Border>
                    <TextBlock Text="{Binding SelectedChange.Folder}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="StageLinesButton" Style="{StaticResource Tool.Ghost}" Tag="&#xE710;" Content="Stage lines" Click="StageLines_Click"
                            ToolTip="Stage the selected lines (Ctrl / Shift+click picks several). Select a @@ line for the whole hunk. Key: S"
                            Visibility="{Binding SelectedChange.Staged, Converter={StaticResource Vis}, ConverterParameter=invert, FallbackValue=Collapsed}"/>
                    <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE738;" Content="Unstage lines" Click="UnstageLines_Click"
                            ToolTip="Take the selected lines back out of the commit (your file keeps them). Select a @@ line for the whole hunk. Key: U"
                            Visibility="{Binding SelectedChange.Staged, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                    <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE7A7;" Content="Discard lines" Click="DiscardLines_Click"
                            ToolTip="Throw away the selected lines (unstaged files only). Key: D"
                            Visibility="{Binding SelectedChange.Staged, Converter={StaticResource Vis}, ConverterParameter=invert, FallbackValue=Collapsed}"/>
                    <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE8A7;" Content="Open in window" Command="{Binding PopOutChangeDiffCommand}"
                            ToolTip="Open this diff in its own resizable window"/>
                    <CheckBox Content="Split diff" IsChecked="{Binding IsSplitDiff}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Side-by-side split diff view"/>
                    <CheckBox Content="Ignore whitespace" IsChecked="{Binding IgnoreWhitespace}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="git diff -w"/>
                </WrapPanel>
            </StackPanel>
            <ListBox x:Name="DiffBox" Grid.Row="1" Style="{StaticResource DiffList}" ItemsSource="{Binding ChangeDiff}" PreviewKeyDown="DiffBox_PreviewKeyDown"
                     Visibility="{Binding IsSplitDiff, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Stage / unstage selected lines (S)" Click="ToggleLines_Click"/>
                        <MenuItem Header="Select whole hunk (H)" Click="SelectHunk_Click"/>
                        <MenuItem Header="Discard selected lines (D)" Click="DiscardLines_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <views:SplitDiffView Grid.Row="1" ItemsSource="{Binding ChangeSplitDiff}" Visibility="{Binding IsSplitDiff, Converter={StaticResource Vis}}"/>
        </Grid>
    </Grid>
</UserControl>
