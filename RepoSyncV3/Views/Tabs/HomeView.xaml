<UserControl x:Class="RepoSyncV3.Views.Tabs.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RepoSyncV3.Views"
             xmlns:vm="clr-namespace:RepoSyncV3.ViewModels"
             xmlns:m="clr-namespace:RepoSyncV3.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid Visibility="{Binding ShowHome, Converter={StaticResource Vis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Home" Style="{StaticResource Text.Title}"/>
                    <Border CornerRadius="9" Padding="9,2,9,3" Margin="12,4,0,0" VerticalAlignment="Center" Background="{Binding ScopeBrush}">
                        <TextBlock Text="{Binding ScopeName}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="12,4,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding Dashboard.Loading, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                    <Run Text="Everything that needs you across the repos in this profile. Click a line to open it."/><Run Text="  "/><Run Text="{Binding Dashboard.LoadedText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Column="1" Width="240" VerticalAlignment="Top">
                <TextBox Text="{Binding Dashboard.Filter, UpdateSourceTrigger=PropertyChanged}" Padding="28,5,8,5"/>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Foreground="{DynamicResource Brush.TextSecondary}" Margin="10,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Filter" Foreground="{DynamicResource Brush.TextSecondary}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Dashboard.Filter, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
            </Grid>
        </Grid>

        <!-- bulk actions for the workspace -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,12,0,0">
            <WrapPanel>
                <Button Style="{StaticResource Tool}" Tag="&#xE72C;" Content="Refresh" Command="{Binding Dashboard.RefreshCommand}" ToolTip="Re-read the merge / pull request lists"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE80A;" Command="{Binding ShowOverviewCommand}"
                        ToolTip="Every repo in one sortable table, plus what background fetches found (Ctrl+Alt+H)">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Overview"/>
                            <TextBlock Text="{Binding FeedUnread, StringFormat=' ({0} new)'}" Visibility="{Binding FeedUnread, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Border Width="1" Background="{DynamicResource Brush.Divider}" Margin="6,4,12,4"/>
                <Button views:ShortcutTip.Id="fetch-all" Style="{StaticResource Tool}" Tag="&#xE896;" Content="Fetch all" Command="{Binding FetchAllCommand}" ToolTip="Ask the server for news on every repo in this profile"/>
                <Button views:ShortcutTip.Id="pull-all" Style="{StaticResource Tool}" Tag="&#xE74B;" Content="Pull all" Command="{Binding PullAllCommand}" ToolTip="Fast-forward every repo in this profile that can be updated safely"/>
                <Button views:ShortcutTip.Id="commit-all" Style="{StaticResource Tool}" Tag="&#xE73E;" Content="Commit all" Command="{Binding CommitAllCommand}" ToolTip="Commit every repo in this profile that has changes (you review the list and messages first)"/>
                <Button views:ShortcutTip.Id="push-all" Style="{StaticResource Tool}" Tag="&#xE74A;" Content="Push all" Command="{Binding PushAllCommand}" ToolTip="Push every repo in this profile whose commits can go straight to the server"/>
                <Button views:ShortcutTip.Id="cleanup-all" Style="{StaticResource Tool}" Tag="&#xE894;" Content="Clean up branches" Command="{Binding CleanupAllCommand}" ToolTip="Delete merged / gone-on-server branches in every repo of this profile (you pick which)"/>
                <Button views:ShortcutTip.Id="search" Style="{StaticResource Tool}" Tag="&#xE721;" Content="Search" Command="{Binding SearchReposCommand}" ToolTip="Search commits, branches, merge requests and code of every repo in this profile (Ctrl+Shift+F)"/>
                <Button views:ShortcutTip.Id="standup" Style="{StaticResource Tool}" Tag="&#xE823;" Content="What I did" Command="{Binding StandupCommand}" ToolTip="Your commits since the last workday across this profile, ready to paste into a standup or timesheet"/>
                <Border Width="1" Background="{DynamicResource Brush.Divider}" Margin="6,4,12,4"/>
                <Button views:ShortcutTip.Id="clone" Style="{StaticResource Tool}" Tag="&#xE753;" Content="Clone" Command="{Binding CloneCommand}"/>
                <Button views:ShortcutTip.Id="accounts" Style="{StaticResource Tool}" Tag="&#xE8D7;" Content="Accounts" Command="{Binding TokenCommand}"/>
            </WrapPanel>
        </Border>

        <!-- banner (same as on a repo) -->
        <Border Grid.Row="2" Style="{StaticResource Pill}" Tag="{Binding BannerTone}" CornerRadius="8" Padding="10,6" Margin="0,6,0,0"
                HorizontalAlignment="Stretch" Visibility="{Binding BannerVisible, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding BannerTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BannerText}" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding BannerText, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconOnly}" Content="&#xE711;" VerticalAlignment="Top" AutomationProperties.Name="Dismiss" Command="{Binding DismissBannerCommand}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Margin="0,0,6,6">
                <!-- first run: three steps, each ticks itself off -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Visibility="{Binding ShowGetStarted, Converter={StaticResource Vis}}">
                    <Border.Resources>
                        <Style x:Key="StepTick" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xEA3A;"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                            <Setter Property="Width" Value="22"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                    <DataTrigger.Value><sys:Boolean>True</sys:Boolean></DataTrigger.Value>
                                    <Setter Property="Text" Value="&#xE73E;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconOnly}" Content="&#xE711;" AutomationProperties.Name="Close the Get started list"
                                    ToolTip="Hide this list" Command="{Binding DismissGetStartedCommand}"/>
                            <TextBlock Text="Get started" FontSize="15" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,10" Text="Three steps and the app takes care of the rest."/>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource StepTick}" Tag="{Binding StepAccountsDone}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Tool.Ghost}" Content="Accounts..." Command="{Binding TokenCommand}"/>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="1. Add a GitHub and / or GitLab token, so merge requests and pipelines show up."/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource StepTick}" Tag="{Binding StepIdentityDone}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Tool.Ghost}" Content="Profiles..." Command="{Binding ManageProfilesCommand}"/>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="2. Set up your profiles: who you commit as in each, and add more than Personal / Work if you like (e.g. School). Each profile has its own repo list."/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Style="{StaticResource StepTick}" Tag="{Binding StepReposDone}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Tool.Ghost}" Content="Clone..." Command="{Binding CloneCommand}"/>
                                <Button Style="{StaticResource Tool.Ghost}" Content="Add..." Command="{Binding AddRepoCommand}"/>
                                <Button Style="{StaticResource Tool.Ghost}" Content="Scan..." Command="{Binding ScanFolderCommand}"/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="3. Add your repos: clone from the server, add a folder, or scan a whole folder."/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Pill}" Tag="warning" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        Visibility="{Binding Dashboard.ServerNote, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Dashboard.ServerNote}" TextWrapping="Wrap" FontWeight="Normal" FontSize="12"/>
                </Border>
                <Border Style="{StaticResource Pill}" Tag="success" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                        Visibility="{Binding Dashboard.AllClear, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="All clear" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Nothing to commit, push or pull, no failing checks, no open merge / pull requests waiting on you." FontWeight="Normal" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}">
                                    <Run Text="NEEDS YOU ON THIS PC ("/><Run Text="{Binding Dashboard.Attention.Count, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Dashboard.Attention}" ItemTemplate="{StaticResource DashRow}"/>
                                <TextBlock Text="Every repo is committed, pushed and up to date." Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding Dashboard.Attention.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}">
                                    <Run Text="PIPELINES / CHECKS FAILING OR RUNNING ("/><Run Text="{Binding Dashboard.Checks.Count, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Dashboard.Checks}" ItemTemplate="{StaticResource DashRow}"/>
                                <TextBlock Text="Nothing failing or running on your current branches." Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding Dashboard.Checks.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="{Binding Dashboard.Reminders.Count, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}">
                                    <Run Text="TIDY UP ("/><Run Text="{Binding Dashboard.Reminders.Count, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Dashboard.Reminders}" ItemTemplate="{StaticResource DashRow}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}">
                                    <Run Text="MY OPEN MERGE / PULL REQUESTS ("/><Run Text="{Binding Dashboard.MyMergeRequests.Count, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Dashboard.MyMergeRequests}" ItemTemplate="{StaticResource DashRow}"/>
                                <TextBlock Text="You have no open merge / pull requests." Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding Dashboard.MyMergeRequests.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}">
                                    <Run Text="WAITING FOR MY REVIEW ("/><Run Text="{Binding Dashboard.ReviewRequests.Count, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Dashboard.ReviewRequests}" ItemTemplate="{StaticResource DashRow}"/>
                                <TextBlock Text="Nobody is waiting for your review." Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding Dashboard.ReviewRequests.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}">
                            <Run Text="MY COMMITS, LAST 14 DAYS ("/><Run Text="{Binding Dashboard.ActivityTotal, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Dashboard.Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RepoName}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Bars}" Height="22" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="10" Height="{Binding Height}" Margin="0,0,3,0" CornerRadius="2" VerticalAlignment="Bottom"
                                                            Background="{DynamicResource Brush.Accent}" ToolTip="{Binding Tip}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Any}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.25"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No commits by you in the last 14 days (matched by each repo's git email)." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding Dashboard.Activity.Count, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
