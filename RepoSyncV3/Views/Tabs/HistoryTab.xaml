<UserControl x:Class="RepoSyncV3.Views.Tabs.HistoryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RepoSyncV3.ViewModels"
             xmlns:m="clr-namespace:RepoSyncV3.Models"
             xmlns:views="clr-namespace:RepoSyncV3.Views"
             xmlns:s="clr-namespace:RepoSyncV3.Services">
    <UserControl.Resources>
        <views:GraphColorConverter x:Key="GraphColor"/>
        <!-- A ref label: local branch = solid in the graph line color, checked-out branch = solid + bold + check mark,
             remote branch = outlined and dimmer with a cloud, tag = neutral with a colored tag glyph. Branches click to filter. -->
        <DataTemplate x:Key="RefLabelTemplate" DataType="s:RefLabel">
            <Button x:Name="Btn" Focusable="False" Cursor="Hand" ToolTip="{Binding ToolTip}" Margin="0,0,4,0" VerticalAlignment="Center"
                    Command="{Binding DataContext.FilterBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="Bd" CornerRadius="3" Padding="5,0,6,1" BorderThickness="1"
                        BorderBrush="{Binding Color, Converter={StaticResource GraphColor}}" Background="{Binding Color, Converter={StaticResource GraphColor}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Glyph" FontFamily="{StaticResource Font.Icons}" FontSize="9" Margin="0,1,4,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="Txt" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#14181C" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHead}" Value="True">
                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="#14181C"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRemote}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                    <Setter TargetName="Txt" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{Binding Color, Converter={StaticResource GraphColor}}"/>
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE753;"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Color, Converter={StaticResource GraphColor}}"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTag}" Value="True">
                    <Setter TargetName="Btn" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Tint.Neutral}"/>
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE8EC;"/>
                    <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Color, Converter={StaticResource GraphColor}}"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBranch}" Value="False">
                    <Setter TargetName="Btn" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding HistoryScope}">
                <ComboBoxItem Content="This branch" Tag="current"/>
                <ComboBoxItem Content="Default branch" Tag="default"/>
                <ComboBoxItem Content="All branches" Tag="all"/>
            </ComboBox>
            <ComboBox Grid.Column="1" Margin="6,0,0,0" Width="128" SelectedValuePath="Tag" SelectedValue="{Binding HistorySearchMode}"
                      ToolTip="Filter = the loaded list as you type. The others search all of history when you press Enter.">
                <ComboBoxItem Content="Filter list" Tag="filter"/>
                <ComboBoxItem Content="Search message" Tag="message"/>
                <ComboBoxItem Content="Search code" Tag="code"/>
                <ComboBoxItem Content="Search file name" Tag="file"/>
            </ComboBox>
            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown"
                     ToolTip="Filter list: message, author, hash or branch. Search code: commits that added or removed this text (git log -S). Enter searches."/>
            <WrapPanel Grid.Column="3" HorizontalAlignment="Right">
                <Button Style="{StaticResource Tool}" Tag="&#xE8C8;" Content="Copy hash" Command="{Binding CopyHashCommand}"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE8A7;" Content="{Binding Repo.ServerName}" Command="{Binding OpenCommitCommand}"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE710;" Content="Branch here" Command="{Binding BranchFromCommitCommand}"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE8C8;" Content="Cherry-pick" Command="{Binding CherryPickCommand}" ToolTip="Copy this commit onto your branch (pick it from another branch's history)"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE7A7;" Content="Revert" Command="{Binding RevertCommand}" ToolTip="Add a commit that undoes this one"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE8EC;" Content="Tag" Command="{Binding CreateTagCommand}" ToolTip="Create tag at this commit"/>
                <Button Style="{StaticResource Tool}" Tag="&#xE8CB;" Content="Rewrite..." Command="{Binding InteractiveRebaseCommand}" ToolTip="Interactive rebase: reorder, reword, squash or drop this branch's commits"/>
            </WrapPanel>
        </Grid>
        <!-- "showing only X" chip while a branch label filter is on -->
        <Border Grid.Row="1" Style="{StaticResource Pill}" Tag="info" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="9,2,4,3"
                Visibility="{Binding IsBranchFiltered, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource Font.Icons}" Text="&#xE71C;" FontSize="10" VerticalAlignment="Center" Margin="0,1,6,0"/>
                <TextBlock VerticalAlignment="Center"><Run Text="Showing only "/><Run Text="{Binding BranchFilter, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}"/></TextBlock>
                <Button Style="{StaticResource Button.Link}" Content="Show all" Margin="10,0,4,0" VerticalAlignment="Center" Command="{Binding ClearBranchFilterCommand}"
                        ToolTip="Back to the branch scope picked on the left"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Style="{StaticResource Grid.List}" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}"
                          SelectionChanged="Commits_SelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy hash" Command="{Binding CopyHashCommand}"/>
                            <MenuItem Header="Create branch here..." Command="{Binding BranchFromCommitCommand}"/>
                            <MenuItem Header="Cherry-pick commit" Command="{Binding CherryPickCommand}"/>
                            <MenuItem Header="Revert commit" Command="{Binding RevertCommand}"/>
                            <Separator/>
                            <MenuItem Header="Reset branch to this commit">
                                <MenuItem Header="Soft reset (keep changes staged)" Command="{Binding ResetCommand}" CommandParameter="soft"/>
                                <MenuItem Header="Mixed reset (keep changes in working tree)" Command="{Binding ResetCommand}" CommandParameter="mixed"/>
                                <MenuItem Header="Hard reset (discard all changes)" Command="{Binding ResetCommand}" CommandParameter="hard"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Create tag here..." Command="{Binding CreateTagCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="GraphColumn" Header="Graph" Width="Auto" MaxWidth="240">
                            <!-- full row height, no padding: the lines must touch the rows above and below -->
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <ContentPresenter VerticalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <views:GraphCell Row="{Binding Graph}" VerticalAlignment="Stretch"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="22">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Status.Ahead}" ToolTip="Not pushed yet"
                                             Visibility="{Binding IsUnpushed, Converter={StaticResource Vis}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Hash" Width="78">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ShortHash}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.Accent}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Message" Width="4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- one label per ref, in the commit's graph line color; branches click to filter -->
                                        <ItemsControl ItemsSource="{Binding Labels}" ItemTemplate="{StaticResource RefLabelTemplate}" VerticalAlignment="Center" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*"/>
                        <DataGridTextColumn Header="When" Binding="{Binding Date, Converter={StaticResource Ago}}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Date, Converter={StaticResource Exact}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center">
                        <Run Text="{Binding Commits.Count, Mode=OneWay}"/><Run Text=" commits  ·  "/>
                        <Run Foreground="{DynamicResource Brush.Status.Ahead}" Text="●"/><Run Text=" = not pushed yet"/>
                    </TextBlock>
                    <Button Style="{StaticResource Button.Link}" HorizontalAlignment="Right" Content="Load more" Command="{Binding LoadMoreHistoryCommand}"/>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="10,8">
                    <StackPanel>
                        <TextBox Text="{Binding CommitBody, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                 MaxHeight="110" VerticalScrollBarVisibility="Auto" Padding="0" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                            <Run Text="{Binding SelectedCommit.Author, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedCommit.Date, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm'}"/><Run Text="  ·  "/><Run Text="{Binding SelectedCommit.ShortHash, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,8">
                <Grid Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="1,0,0,0">
                        <Run Text="FILES ("/><Run Text="{Binding CommitFiles.Count, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                    <CheckBox Content="Folders" IsChecked="{Binding IsFileTree}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip="Group the commit's files by folder (also in Changes). Double-click or Left / Right folds a folder."/>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="4" MaxHeight="220">
                    <ListBox x:Name="CommitFileList" ItemsSource="{Binding CommitFilesTree.Items}" ItemTemplateSelector="{StaticResource CommitTreeRows}"
                             SelectedItem="{Binding SelectedCommitFile, Converter={StaticResource FileRowOnly}}"
                             MouseDoubleClick="CommitFileList_DoubleClick" PreviewKeyDown="CommitFileList_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="View file history..." Command="{Binding ViewFileHistoryCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Git blame..." Command="{Binding BlameCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Open in editor" Command="{Binding OpenFileCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Border>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- which file this diff is for: name first, folder trims first, full path in the tooltip -->
                        <DockPanel VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent" ToolTip="{Binding SelectedCommitFile.Path}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedCommitFile.FileName}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedCommitFile.Folder}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Tool.Ghost}" Tag="&#xE8A7;" Content="Open in window" Command="{Binding PopOutCommitDiffCommand}" Margin="0,0,10,0"
                                    ToolTip="Open this diff in its own resizable window"/>
                            <CheckBox Content="Split diff" IsChecked="{Binding IsSplitDiff}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Side-by-side split diff view"/>
                            <CheckBox Content="Ignore whitespace" IsChecked="{Binding IgnoreWhitespace}" VerticalAlignment="Center" ToolTip="git diff -w"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" Style="{StaticResource DiffList}" ItemsSource="{Binding CommitDiff}" Visibility="{Binding IsSplitDiff, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                    <views:SplitDiffView Grid.Row="1" ItemsSource="{Binding CommitSplitDiff}" Visibility="{Binding IsSplitDiff, Converter={StaticResource Vis}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
