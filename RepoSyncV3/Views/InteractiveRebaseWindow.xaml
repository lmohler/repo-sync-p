<Window x:Class="RepoSyncV3.Views.InteractiveRebaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="900" Title="Interactive rebase">
    <StackPanel Margin="14,12">
        <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="Rewrite commits"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/>
        <Border x:Name="PushedWarning" Style="{StaticResource Pill}" Tag="warning" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontWeight="Normal"
                       Text="Some of these commits are already on the server. After rewriting, you will need Force push, and anyone else on this branch has to reset to it."/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="Steps" Style="{StaticResource Grid.List}" AutoGenerateColumns="False" CanUserSortColumns="False"
                      HeadersVisibility="Column" SelectionMode="Single" Height="340" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Margin="0,1">
                                    <ComboBoxItem Content="pick" Tag="pick" ToolTip="Keep the commit"/>
                                    <ComboBoxItem Content="reword" Tag="reword" ToolTip="Keep it with the new message"/>
                                    <ComboBoxItem Content="squash" Tag="squash" ToolTip="Melt into the commit above, keeping both messages"/>
                                    <ComboBoxItem Content="fixup" Tag="fixup" ToolTip="Melt into the commit above, dropping this message"/>
                                    <ComboBoxItem Content="drop" Tag="drop" ToolTip="Remove the commit"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Hash" Binding="{Binding ShortHash}" IsReadOnly="True" Width="75"/>
                    <DataGridTextColumn Header="Message (edit for reword)" Binding="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Move up" Click="Up_Click" Margin="0,0,0,6"/>
                <Button Content="Move down" Click="Down_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Text="Oldest first, like git rebase -i. If a step conflicts, finish it on the Changes tab (Continue / Abort). Recover... can undo the whole rewrite."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Rewrite" Style="{StaticResource Button.Primary}" Click="Ok_Click" Margin="0,0,8,0" MinWidth="90"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
