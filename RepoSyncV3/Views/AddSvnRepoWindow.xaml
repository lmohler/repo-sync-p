<Window x:Class="RepoSyncV3.Views.AddSvnRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="640" Title="Add SVN repo">
    <StackPanel Margin="20,18">
        <TextBlock Style="{StaticResource Text.Heading}" FontSize="15" Text="Add an SVN repo"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Checks out SVN (or uses an existing working copy), makes a git repo whose 'main' mirrors SVN, and gives your work branch its own folder. Steps already done are skipped, so you can run it again on a half-set-up folder."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="SVN URL" Margin="1,16,0,6"/>
        <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged" AutomationProperties.Name="SVN URL"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="1,4,0,0" TextWrapping="Wrap"
                   Text="e.g. https://svn.example.com/svn/my-repo/trunk - leave empty if the folder below already is a working copy."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="SVN WORKING COPY" Margin="1,14,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseFolder_Click"/>
            <TextBox x:Name="FolderBox" TextChanged="FolderBox_TextChanged" AutomationProperties.Name="SVN working copy folder"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="1,4,0,0" TextWrapping="Wrap"
                   Text="SVN checks out here and git 'main' mirrors it. Don't edit or commit in this folder."/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="WORK BRANCH" Margin="1,0,0,6"/>
                <TextBox x:Name="BranchBox" Text="work" TextChanged="BranchBox_TextChanged" AutomationProperties.Name="Work branch"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource SectionLabel}" Text="PROFILE" Margin="1,0,0,6"/>
                <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" AutomationProperties.Name="Profile"/>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SectionLabel}" Text="WORK FOLDER" Margin="1,14,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseWorktree_Click"/>
            <TextBox x:Name="WorktreeBox" TextChanged="WorktreeBox_TextChanged" AutomationProperties.Name="Work folder"/>
        </DockPanel>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="1,4,0,0" TextWrapping="Wrap"
                   Text="The work branch's own folder (a git worktree), next to the working copy. Do all your work here."/>

        <Border x:Name="ErrorBorder" Style="{StaticResource Pill}" Tag="error" CornerRadius="6" Padding="10,6" Margin="0,14,0,0"
                HorizontalAlignment="Stretch" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontWeight="Normal" FontSize="12"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
            <Button Content="Set up" IsDefault="True" Style="{StaticResource Button.Primary}" MinWidth="90" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
